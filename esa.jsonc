{
  "name": "libretv",
  "installCommand": "npm install",
  "buildCommand": "npm install shx --save-dev && npm run build && shx cp -r public .next/standalone/ && shx cp -r .next/static .next/standalone/.next/",
  "startCommand": "node .next/standalone/server.js",
  "entry": "./.next/standalone/server.js",
  "assets": {
    "directory": "./.next/standalone"
  },
  "env": {
    "NODE_ENV": "production"
  }
}
