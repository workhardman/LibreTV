{
  "name": "libretv",
  "installCommand": "npm install",
  "buildCommand": "npm run build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
  "startCommand": "node .next/standalone/server.js",
  "entry": "./.next/standalone/server.js",
  "assets": {
    "directory": "./.next/standalone"
  },
  "env": {
    "NODE_ENV": "production"
  }
}
